# Secrets live here, never in config.yaml. Copy to .env and fill in.
# Reference them from config.yaml via `tokenEnv: <VAR_NAME>`.

# Read-only GitHub PATs (classic PAT with `read:user` scope, or fine-grained
# with read-only access). A token pulls PRIVATE contributions for its own account.
ACTIWITEE_GITHUB_PERSONAL_TOKEN=
ACTIWITEE_GITHUB_WORK_TOKEN=
